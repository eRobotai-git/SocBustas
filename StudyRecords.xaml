    <ui:InvokeCode Code="' ============================================================================&#xA;' Invoke Code: Studentų / Mokinių registro išrašas (PDF) -&gt; out_Studentas  (pakeičia Tabula UI)&#xA;' Taisyklė (kaip ankstesnėje StudyRecords.xaml): lentelėse, kurių antraštėje yra &quot;nuo&quot; ir &quot;iki&quot;,&#xA;' imami du paskutiniai stulpeliai (pradžia, pabaiga). Mokosi = True, jei yra eilutė su pradžios data&#xA;' (prasideda &quot;20&quot;) ir be pabaigos datos (PDD: stulpelyje „Galioja iki“ / „Iki“ nėra reikšmės).&#xA;' Eilutės be pradžios datos (pvz. neformalusis ugdymas) ir &quot;Nėra duomenų&quot; neįskaitomos.&#xA;'&#xA;' Argumentai:&#xA;'   in_Path          In   String&#xA;'   in_JavaPath      In   String      neprivaloma&#xA;'   out_Studentas    Out  Boolean&#xA;'   out_JavaUsed     Out  String&#xA;'   out_TableCount   Out  Int32&#xA;'   out_Reason       Out  String      kuri eilutė lėmė True (log), be asmens duomenų&#xA;' ============================================================================&#xA;&#xA;' ---------- 1. java.exe paieška ----------&#xA;Dim javaExe As String = &quot;&quot;&#xA;Dim jarPath As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Data&quot;, &quot;Tools&quot;, &quot;tabula-1.0.5-jar-with-dependencies.jar&quot;)&#xA;If Not System.IO.File.Exists(jarPath) Then&#xA;    Throw New System.Exception(&quot;Nerastas tabula jar failas: &quot; &amp; jarPath)&#xA;End If&#xA;If Not String.IsNullOrWhiteSpace(in_JavaPath) AndAlso System.IO.File.Exists(in_JavaPath.Trim()) Then&#xA;    javaExe = in_JavaPath.Trim()&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Dim searchRoots As New System.Collections.Generic.List(Of String)()&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), &quot;Documents&quot;, &quot;tabula&quot;))&#xA;    Dim javaHome As String = System.Environment.GetEnvironmentVariable(&quot;JAVA_HOME&quot;)&#xA;    If Not String.IsNullOrWhiteSpace(javaHome) Then searchRoots.Add(javaHome)&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Eclipse Adoptium&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Microsoft&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Common Files&quot;, &quot;Oracle&quot;, &quot;Java&quot;))&#xA;    For Each rootDir As String In searchRoots&#xA;        If javaExe &lt;&gt; &quot;&quot; Then Exit For&#xA;        If Not System.IO.Directory.Exists(rootDir) Then Continue For&#xA;        Try&#xA;            Dim found As String() = System.IO.Directory.GetFiles(rootDir, &quot;java.exe&quot;, System.IO.SearchOption.AllDirectories)&#xA;            If found.Length &gt; 0 Then javaExe = found(0)&#xA;        Catch exSearch As System.Exception&#xA;        End Try&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    For Each pathDir As String In (If(System.Environment.GetEnvironmentVariable(&quot;PATH&quot;), &quot;&quot;)).Split(&quot;;&quot;c)&#xA;        Dim cand As String = System.IO.Path.Combine(pathDir.Trim().Trim(&quot;&quot;&quot;&quot;c), &quot;java.exe&quot;)&#xA;        If pathDir.Trim() &lt;&gt; &quot;&quot; AndAlso System.IO.File.Exists(cand) Then&#xA;            javaExe = cand&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Throw New System.Exception(&quot;Nerastas java.exe (ieškota Documents\tabula, JAVA_HOME, Program Files, PATH). Nurodykite java.exe kelią argumentu in_JavaPath.&quot;)&#xA;End If&#xA;out_JavaUsed = javaExe&#xA;&#xA;' ---------- 2. tabula-java: PDF -&gt; JSON (lattice, visi puslapiai) ----------&#xA;Dim pdfFull As String = System.IO.Path.GetFullPath(in_Path)&#xA;If Not System.IO.File.Exists(pdfFull) Then&#xA;    Throw New System.Exception(&quot;Nerastas PDF failas: &quot; &amp; pdfFull)&#xA;End If&#xA;Dim jsonFile As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;tabula_&quot; &amp; System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.json&quot;)&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;psi.FileName = javaExe&#xA;psi.Arguments = &quot;-Dfile.encoding=UTF-8 -jar &quot;&quot;&quot; &amp; jarPath &amp; &quot;&quot;&quot; -l -p all -f JSON -o &quot;&quot;&quot; &amp; jsonFile &amp; &quot;&quot;&quot; &quot;&quot;&quot; &amp; pdfFull &amp; &quot;&quot;&quot;&quot;&#xA;psi.UseShellExecute = False&#xA;psi.CreateNoWindow = True&#xA;psi.RedirectStandardError = True&#xA;psi.RedirectStandardOutput = False&#xA;Dim errText As String = &quot;&quot;&#xA;Dim exitCode As Integer = -1&#xA;Using proc As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;    errText = proc.StandardError.ReadToEnd()&#xA;    If Not proc.WaitForExit(120000) Then&#xA;        Try&#xA;            proc.Kill()&#xA;        Catch exKill As System.Exception&#xA;        End Try&#xA;        Throw New System.Exception(&quot;tabula-java neatsakė per 120 s: &quot; &amp; in_Path)&#xA;    End If&#xA;    exitCode = proc.ExitCode&#xA;End Using&#xA;If exitCode &lt;&gt; 0 OrElse Not System.IO.File.Exists(jsonFile) Then&#xA;    Throw New System.Exception(&quot;tabula-java klaida (kodas &quot; &amp; exitCode.ToString() &amp; &quot;): &quot; &amp; errText)&#xA;End If&#xA;Dim jsonText As String = System.IO.File.ReadAllText(jsonFile, System.Text.Encoding.UTF8)&#xA;Try&#xA;    System.IO.File.Delete(jsonFile)&#xA;Catch exDel As System.Exception&#xA;End Try&#xA;&#xA;' ---------- 3. JSON -&gt; lentelės (List of rows, row = String()) ----------&#xA;' langelių tekstas normalizuojamas: &quot;2024-11-\r11&quot; -&gt; &quot;2024-11-11&quot;, \r ir tarpai -&gt; vienas tarpas&#xA;Dim allTables As New System.Collections.Generic.List(Of System.Collections.Generic.List(Of String()))()&#xA;Using jdoc As System.Text.Json.JsonDocument = System.Text.Json.JsonDocument.Parse(jsonText)&#xA;    For Each jTable As System.Text.Json.JsonElement In jdoc.RootElement.EnumerateArray()&#xA;        Dim tRows As New System.Collections.Generic.List(Of String())()&#xA;        For Each jRow As System.Text.Json.JsonElement In jTable.GetProperty(&quot;data&quot;).EnumerateArray()&#xA;            Dim cellTexts As New System.Collections.Generic.List(Of String)()&#xA;            For Each jCell As System.Text.Json.JsonElement In jRow.EnumerateArray()&#xA;                Dim cellVal As String = &quot;&quot;&#xA;                Dim textProp As System.Text.Json.JsonElement&#xA;                If jCell.TryGetProperty(&quot;text&quot;, textProp) Then cellVal = If(textProp.GetString(), &quot;&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;-[ \t]*[\r\n]+\s*&quot;, &quot;-&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;                cellTexts.Add(cellVal)&#xA;            Next&#xA;            tRows.Add(cellTexts.ToArray())&#xA;        Next&#xA;        allTables.Add(tRows)&#xA;    Next&#xA;End Using&#xA;out_TableCount = allTables.Count&#xA;&#xA;' ---------- 4. Ar mokosi ----------&#xA;out_Studentas = False&#xA;out_Reason = &quot;&quot;&#xA;For Each tblRows As System.Collections.Generic.List(Of String()) In allTables&#xA;    If tblRows.Count &lt; 2 Then Continue For&#xA;    Dim hdrText As String = String.Join(&quot; &quot;, tblRows(0)).ToLower()&#xA;    If Not (System.Text.RegularExpressions.Regex.IsMatch(hdrText, &quot;\bnuo\b&quot;) AndAlso System.Text.RegularExpressions.Regex.IsMatch(hdrText, &quot;\biki\b&quot;)) Then Continue For&#xA;    For rowIdx As Integer = 1 To tblRows.Count - 1&#xA;        Dim rc As String() = tblRows(rowIdx)&#xA;        If rc.Length &lt; 2 Then Continue For&#xA;        Dim startDate As String = rc(rc.Length - 2)&#xA;        Dim endDate As String = rc(rc.Length - 1)&#xA;        If Not startDate.StartsWith(&quot;20&quot;) Then Continue For&#xA;        If endDate = &quot;&quot; Then&#xA;            out_Studentas = True&#xA;            out_Reason = &quot;pradžia &quot; &amp; startDate &amp; &quot;, be pabaigos datos&quot;&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;    If out_Studentas Then Exit For&#xA;Next&#xA;" ContinueOnError="{x:Null}" DisplayName="Tabula_Study: PDF -> ar mokosi (tabula-java)" Language="VBNet">
        <ui:InvokeCode.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_Path">[in_Path]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JavaPath">[in_JavaPath]</InArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_Studentas">[out_Studentas]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_JavaUsed">[javaUsed]</OutArgument>
          <OutArgument x:TypeArguments="x:Int32" x:Key="out_TableCount">[tableCount]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_Reason">[reason]</OutArgument>
        </ui:InvokeCode.Arguments>
      </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log Studentas" Level="Info" Message="[&quot;Studijų/mokymosi išrašas: lentelių &quot; &amp; tableCount.ToString &amp; &quot;, mokosi = &quot; &amp; out_Studentas.ToString &amp; If(reason = &quot;&quot;, &quot;&quot;, &quot; (&quot; &amp; reason &amp; &quot;)&quot;)]" />
  </Sequence>
</Activity>

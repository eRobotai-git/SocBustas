    <ui:InvokeCode Code="' ============================================================================&#xA;' Invoke Code: Gyventojų registro išrašas (PDF) -&gt; out_ExtractDataTable  (pakeičia Tabula UI)&#xA;' Grąžina tą pačią struktūrą kaip anksčiau: stulpeliai Column-0..Column-11,&#xA;' be antraštės eilutės (kaip seniau po Remove Data Row) + stulpelis Sutapimas.&#xA;' Imamos tik eilutės, kurių 1-ame stulpelyje yra 11 skaitmenų asmens kodas&#xA;' (praleidžiamos &quot;Klaidos požymis...&quot; ir pasikartojančios antraštės).&#xA;'&#xA;' Argumentai:&#xA;'   in_Path          In   String      PDF kelias&#xA;'   in_JavaPath      In   String      neprivaloma; tuščia -&gt; ieškoma automatiškai&#xA;'   out_ExtractDataTable Out DataTable  (be antraštės, Column-0..11 + Sutapimas)&#xA;'   out_JavaUsed     Out  String      kuris java.exe panaudotas (log)&#xA;'   out_TableCount   Out  Int32       kiek lentelių rasta PDF&#xA;' ============================================================================&#xA;&#xA;' ---------- 1. java.exe paieška ----------&#xA;Dim javaExe As String = &quot;&quot;&#xA;Dim jarPath As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Data&quot;, &quot;Tools&quot;, &quot;tabula-1.0.5-jar-with-dependencies.jar&quot;)&#xA;If Not System.IO.File.Exists(jarPath) Then&#xA;    Throw New System.Exception(&quot;Nerastas tabula jar failas: &quot; &amp; jarPath)&#xA;End If&#xA;If Not String.IsNullOrWhiteSpace(in_JavaPath) AndAlso System.IO.File.Exists(in_JavaPath.Trim()) Then&#xA;    javaExe = in_JavaPath.Trim()&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Dim searchRoots As New System.Collections.Generic.List(Of String)()&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), &quot;Documents&quot;, &quot;tabula&quot;))&#xA;    Dim javaHome As String = System.Environment.GetEnvironmentVariable(&quot;JAVA_HOME&quot;)&#xA;    If Not String.IsNullOrWhiteSpace(javaHome) Then searchRoots.Add(javaHome)&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Eclipse Adoptium&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Microsoft&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Common Files&quot;, &quot;Oracle&quot;, &quot;Java&quot;))&#xA;    For Each rootDir As String In searchRoots&#xA;        If javaExe &lt;&gt; &quot;&quot; Then Exit For&#xA;        If Not System.IO.Directory.Exists(rootDir) Then Continue For&#xA;        Try&#xA;            Dim found As String() = System.IO.Directory.GetFiles(rootDir, &quot;java.exe&quot;, System.IO.SearchOption.AllDirectories)&#xA;            If found.Length &gt; 0 Then javaExe = found(0)&#xA;        Catch exSearch As System.Exception&#xA;        End Try&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    For Each pathDir As String In (If(System.Environment.GetEnvironmentVariable(&quot;PATH&quot;), &quot;&quot;)).Split(&quot;;&quot;c)&#xA;        Dim cand As String = System.IO.Path.Combine(pathDir.Trim().Trim(&quot;&quot;&quot;&quot;c), &quot;java.exe&quot;)&#xA;        If pathDir.Trim() &lt;&gt; &quot;&quot; AndAlso System.IO.File.Exists(cand) Then&#xA;            javaExe = cand&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Throw New System.Exception(&quot;Nerastas java.exe (ieškota Documents\tabula, JAVA_HOME, Program Files, PATH). Nurodykite java.exe kelią argumentu in_JavaPath.&quot;)&#xA;End If&#xA;out_JavaUsed = javaExe&#xA;&#xA;' ---------- 2. tabula-java: PDF -&gt; JSON (lattice, visi puslapiai) ----------&#xA;Dim pdfFull As String = System.IO.Path.GetFullPath(in_Path)&#xA;If Not System.IO.File.Exists(pdfFull) Then&#xA;    Throw New System.Exception(&quot;Nerastas PDF failas: &quot; &amp; pdfFull)&#xA;End If&#xA;Dim jsonFile As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;tabula_&quot; &amp; System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.json&quot;)&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;psi.FileName = javaExe&#xA;psi.Arguments = &quot;-Dfile.encoding=UTF-8 -jar &quot;&quot;&quot; &amp; jarPath &amp; &quot;&quot;&quot; -l -p all -f JSON -o &quot;&quot;&quot; &amp; jsonFile &amp; &quot;&quot;&quot; &quot;&quot;&quot; &amp; pdfFull &amp; &quot;&quot;&quot;&quot;&#xA;psi.UseShellExecute = False&#xA;psi.CreateNoWindow = True&#xA;psi.RedirectStandardError = True&#xA;psi.RedirectStandardOutput = False&#xA;Dim errText As String = &quot;&quot;&#xA;Dim exitCode As Integer = -1&#xA;Using proc As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;    errText = proc.StandardError.ReadToEnd()&#xA;    If Not proc.WaitForExit(120000) Then&#xA;        Try&#xA;            proc.Kill()&#xA;        Catch exKill As System.Exception&#xA;        End Try&#xA;        Throw New System.Exception(&quot;tabula-java neatsakė per 120 s: &quot; &amp; in_Path)&#xA;    End If&#xA;    exitCode = proc.ExitCode&#xA;End Using&#xA;If exitCode &lt;&gt; 0 OrElse Not System.IO.File.Exists(jsonFile) Then&#xA;    Throw New System.Exception(&quot;tabula-java klaida (kodas &quot; &amp; exitCode.ToString() &amp; &quot;): &quot; &amp; errText)&#xA;End If&#xA;Dim jsonText As String = System.IO.File.ReadAllText(jsonFile, System.Text.Encoding.UTF8)&#xA;Try&#xA;    System.IO.File.Delete(jsonFile)&#xA;Catch exDel As System.Exception&#xA;End Try&#xA;&#xA;' ---------- 3. JSON -&gt; lentelės (List of rows, row = String()) ----------&#xA;' langelių tekstas normalizuojamas: &quot;2024-11-\r11&quot; -&gt; &quot;2024-11-11&quot;, \r ir tarpai -&gt; vienas tarpas&#xA;Dim allTables As New System.Collections.Generic.List(Of System.Collections.Generic.List(Of String()))()&#xA;Using jdoc As System.Text.Json.JsonDocument = System.Text.Json.JsonDocument.Parse(jsonText)&#xA;    For Each jTable As System.Text.Json.JsonElement In jdoc.RootElement.EnumerateArray()&#xA;        Dim tRows As New System.Collections.Generic.List(Of String())()&#xA;        For Each jRow As System.Text.Json.JsonElement In jTable.GetProperty(&quot;data&quot;).EnumerateArray()&#xA;            Dim cellTexts As New System.Collections.Generic.List(Of String)()&#xA;            For Each jCell As System.Text.Json.JsonElement In jRow.EnumerateArray()&#xA;                Dim cellVal As String = &quot;&quot;&#xA;                Dim textProp As System.Text.Json.JsonElement&#xA;                If jCell.TryGetProperty(&quot;text&quot;, textProp) Then cellVal = If(textProp.GetString(), &quot;&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;-[ \t]*[\r\n]+\s*&quot;, &quot;-&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;                cellTexts.Add(cellVal)&#xA;            Next&#xA;            tRows.Add(cellTexts.ToArray())&#xA;        Next&#xA;        allTables.Add(tRows)&#xA;    Next&#xA;End Using&#xA;out_TableCount = allTables.Count&#xA;&#xA;' ---------- 4. DataTable kaip seniau (Column-0..Column-11) ----------&#xA;Dim dtReg As New System.Data.DataTable(&quot;RegData&quot;)&#xA;For colIdx As Integer = 0 To 11&#xA;    dtReg.Columns.Add(&quot;Column-&quot; &amp; colIdx.ToString(), GetType(String))&#xA;Next&#xA;dtReg.Columns.Add(&quot;Sutapimas&quot;, GetType(Object))&#xA;Dim headerRow As String() = Nothing&#xA;Dim personRows As New System.Collections.Generic.List(Of String())()&#xA;For Each tblRows As System.Collections.Generic.List(Of String()) In allTables&#xA;    For Each cells As String() In tblRows&#xA;        If cells.Length &lt;&gt; 12 Then Continue For&#xA;        If System.Text.RegularExpressions.Regex.IsMatch(cells(0), &quot;^\d{11}$&quot;) Then&#xA;            personRows.Add(cells)&#xA;        ElseIf headerRow Is Nothing AndAlso cells(0).ToLower().Contains(&quot;asmens kodas&quot;) Then&#xA;            headerRow = cells&#xA;        End If&#xA;    Next&#xA;Next&#xA;If headerRow Is Nothing Then&#xA;    headerRow = New String() {&quot;Galiojantis asmens kodas&quot;, &quot;Vardas, pavardė&quot;, &quot;Deklaruota gyvenamoji vieta&quot;, &quot;Dekl. data&quot;, &quot;Mirties data&quot;, &quot;Sutuoktinio asmens kodas&quot;, &quot;Šeim. padėtis&quot;, &quot;Ištuokos data&quot;, &quot;Santuokos data&quot;, &quot;Tėvo asmens kodas&quot;, &quot;Motinos asmens kodas&quot;, &quot;Dokumento rūšis&quot;}&#xA;End If&#xA;For Each pr As String() In personRows&#xA;    Dim rowVals(12) As Object&#xA;    For vi As Integer = 0 To 11&#xA;        rowVals(vi) = pr(vi)&#xA;    Next&#xA;    rowVals(12) = DBNull.Value&#xA;    dtReg.Rows.Add(rowVals)&#xA;Next&#xA;If personRows.Count = 0 Then&#xA;    Throw New System.Exception(&quot;Gyventojų registro išraše nerasta nė vieno asmens (lentelių: &quot; &amp; allTables.Count.ToString() &amp; &quot;): &quot; &amp; in_Path)&#xA;End If&#xA;out_ExtractDataTable = dtReg&#xA;" ContinueOnError="{x:Null}" DisplayName="Tabula_GR: PDF -> ExtractDataTable (tabula-java)" Language="VBNet">
    <ui:InvokeCode.Arguments>
      <InArgument x:TypeArguments="x:String" x:Key="in_Path">[in_Path]</InArgument>
      <InArgument x:TypeArguments="x:String" x:Key="in_JavaPath">[in_JavaPath]</InArgument>
      <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_ExtractDataTable">[out_ExtractDataTable]</OutArgument>
      <OutArgument x:TypeArguments="x:String" x:Key="out_JavaUsed">[javaUsed]</OutArgument>
      <OutArgument x:TypeArguments="x:Int32" x:Key="out_TableCount">[tableCount]</OutArgument>
    </ui:InvokeCode.Arguments>
  </ui:InvokeCode>

    <ui:InvokeCode Code="' ============================================================================&#xA;' Invoke Code: ANTA (NDNT) išrašas (PDF) -&gt; rezultatas (pakeičia Tabula UI)&#xA;' Skaitomi VISI puslapiai (lattice). Imamos 16 stulpelių 1-os lentelės eilutės&#xA;' (pasikartojančios antraštės praleidžiamos). Stulpeliai:&#xA;'   0 neįgalumo lygis, 1 laikotarpis | 4 dalyvumo lygis, 6 laikotarpis |&#xA;'   10 poreikiai, 11 laikotarpis, 14 sprendimo negaliojimo data&#xA;' Logika kaip seniau NDNT_PDF.xaml (eilės tvarka apversta, paskutinis tinkamas laimi;&#xA;' Poreikiai &gt; Neįgalumas &gt; Dalyvumas), pataisyta: poreikio laikotarpis imamas iš 11 st.,&#xA;' rezultatas - poreikio tekstas (10 st.), antroji data skaitoma kiekvienai eilutei iš naujo.&#xA;'&#xA;' Argumentai:&#xA;'   in_Path          In   String&#xA;'   in_JavaPath      In   String    neprivaloma&#xA;'   out_ResultValue  Out  String    galutinė reikšmė (anksčiau out_ResultValue)&#xA;'   out_Dalyvumas    Out  String    log&#xA;'   out_Neigalumas   Out  String    log&#xA;'   out_Poreikiai    Out  String    log&#xA;'   out_RowCount     Out  Int32     duomenų eilučių skaičius&#xA;'   out_ExtractDataTable Out DataTable  duomenų eilutės (Column-0..15), PDF eilės tvarka&#xA;'   out_JavaUsed     Out  String&#xA;' ============================================================================&#xA;&#xA;' ---------- 1. java.exe paieška ----------&#xA;Dim javaExe As String = &quot;&quot;&#xA;Dim jarPath As String = System.IO.Path.Combine(System.Environment.CurrentDirectory, &quot;Data&quot;, &quot;Tools&quot;, &quot;tabula-1.0.5-jar-with-dependencies.jar&quot;)&#xA;If Not System.IO.File.Exists(jarPath) Then&#xA;    Throw New System.Exception(&quot;Nerastas tabula jar failas: &quot; &amp; jarPath)&#xA;End If&#xA;If Not String.IsNullOrWhiteSpace(in_JavaPath) AndAlso System.IO.File.Exists(in_JavaPath.Trim()) Then&#xA;    javaExe = in_JavaPath.Trim()&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Dim searchRoots As New System.Collections.Generic.List(Of String)()&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.UserProfile), &quot;Documents&quot;, &quot;tabula&quot;))&#xA;    Dim javaHome As String = System.Environment.GetEnvironmentVariable(&quot;JAVA_HOME&quot;)&#xA;    If Not String.IsNullOrWhiteSpace(javaHome) Then searchRoots.Add(javaHome)&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Eclipse Adoptium&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFiles), &quot;Microsoft&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Java&quot;))&#xA;    searchRoots.Add(System.IO.Path.Combine(System.Environment.GetFolderPath(System.Environment.SpecialFolder.ProgramFilesX86), &quot;Common Files&quot;, &quot;Oracle&quot;, &quot;Java&quot;))&#xA;    For Each rootDir As String In searchRoots&#xA;        If javaExe &lt;&gt; &quot;&quot; Then Exit For&#xA;        If Not System.IO.Directory.Exists(rootDir) Then Continue For&#xA;        Try&#xA;            Dim found As String() = System.IO.Directory.GetFiles(rootDir, &quot;java.exe&quot;, System.IO.SearchOption.AllDirectories)&#xA;            If found.Length &gt; 0 Then javaExe = found(0)&#xA;        Catch exSearch As System.Exception&#xA;        End Try&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    For Each pathDir As String In (If(System.Environment.GetEnvironmentVariable(&quot;PATH&quot;), &quot;&quot;)).Split(&quot;;&quot;c)&#xA;        Dim cand As String = System.IO.Path.Combine(pathDir.Trim().Trim(&quot;&quot;&quot;&quot;c), &quot;java.exe&quot;)&#xA;        If pathDir.Trim() &lt;&gt; &quot;&quot; AndAlso System.IO.File.Exists(cand) Then&#xA;            javaExe = cand&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;End If&#xA;If javaExe = &quot;&quot; Then&#xA;    Throw New System.Exception(&quot;Nerastas java.exe (ieškota Documents\tabula, JAVA_HOME, Program Files, PATH). Nurodykite java.exe kelią argumentu in_JavaPath.&quot;)&#xA;End If&#xA;out_JavaUsed = javaExe&#xA;&#xA;' ---------- 2. tabula-java: PDF -&gt; JSON (lattice, visi puslapiai) ----------&#xA;Dim pdfFull As String = System.IO.Path.GetFullPath(in_Path)&#xA;If Not System.IO.File.Exists(pdfFull) Then&#xA;    Throw New System.Exception(&quot;Nerastas PDF failas: &quot; &amp; pdfFull)&#xA;End If&#xA;Dim jsonFile As String = System.IO.Path.Combine(System.IO.Path.GetTempPath(), &quot;tabula_&quot; &amp; System.Guid.NewGuid().ToString(&quot;N&quot;) &amp; &quot;.json&quot;)&#xA;Dim psi As New System.Diagnostics.ProcessStartInfo()&#xA;psi.FileName = javaExe&#xA;psi.Arguments = &quot;-Dfile.encoding=UTF-8 -jar &quot;&quot;&quot; &amp; jarPath &amp; &quot;&quot;&quot; -l -p all -f JSON -o &quot;&quot;&quot; &amp; jsonFile &amp; &quot;&quot;&quot; &quot;&quot;&quot; &amp; pdfFull &amp; &quot;&quot;&quot;&quot;&#xA;psi.UseShellExecute = False&#xA;psi.CreateNoWindow = True&#xA;psi.RedirectStandardError = True&#xA;psi.RedirectStandardOutput = False&#xA;Dim errText As String = &quot;&quot;&#xA;Dim exitCode As Integer = -1&#xA;Using proc As System.Diagnostics.Process = System.Diagnostics.Process.Start(psi)&#xA;    errText = proc.StandardError.ReadToEnd()&#xA;    If Not proc.WaitForExit(120000) Then&#xA;        Try&#xA;            proc.Kill()&#xA;        Catch exKill As System.Exception&#xA;        End Try&#xA;        Throw New System.Exception(&quot;tabula-java neatsakė per 120 s: &quot; &amp; in_Path)&#xA;    End If&#xA;    exitCode = proc.ExitCode&#xA;End Using&#xA;If exitCode &lt;&gt; 0 OrElse Not System.IO.File.Exists(jsonFile) Then&#xA;    Throw New System.Exception(&quot;tabula-java klaida (kodas &quot; &amp; exitCode.ToString() &amp; &quot;): &quot; &amp; errText)&#xA;End If&#xA;Dim jsonText As String = System.IO.File.ReadAllText(jsonFile, System.Text.Encoding.UTF8)&#xA;Try&#xA;    System.IO.File.Delete(jsonFile)&#xA;Catch exDel As System.Exception&#xA;End Try&#xA;&#xA;&#xA;' ---------- 3. JSON -&gt; 16 stulpelių duomenų eilutės ----------&#xA;Dim dataRows As New System.Collections.Generic.List(Of String())()&#xA;Using jdoc As System.Text.Json.JsonDocument = System.Text.Json.JsonDocument.Parse(jsonText)&#xA;    For Each jTable As System.Text.Json.JsonElement In jdoc.RootElement.EnumerateArray()&#xA;        For Each jRow As System.Text.Json.JsonElement In jTable.GetProperty(&quot;data&quot;).EnumerateArray()&#xA;            Dim cellTexts As New System.Collections.Generic.List(Of String)()&#xA;            For Each jCell As System.Text.Json.JsonElement In jRow.EnumerateArray()&#xA;                Dim cellVal As String = &quot;&quot;&#xA;                Dim textProp As System.Text.Json.JsonElement&#xA;                If jCell.TryGetProperty(&quot;text&quot;, textProp) Then cellVal = If(textProp.GetString(), &quot;&quot;)&#xA;                ' &quot;2004-09\r-16&quot; -&gt; &quot;2004-09-16&quot;; &quot;2028-05-\r18&quot; -&gt; &quot;2028-05-18&quot;; kiti \r -&gt; tarpas&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;[ \t]*[\r\n]+[ \t]*-(?=\d)&quot;, &quot;-&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;(?&lt;=\d)-[ \t]*[\r\n]+[ \t]*(?=\d)&quot;, &quot;-&quot;)&#xA;                cellVal = System.Text.RegularExpressions.Regex.Replace(cellVal, &quot;\s+&quot;, &quot; &quot;).Trim()&#xA;                cellTexts.Add(cellVal)&#xA;            Next&#xA;            If cellTexts.Count &lt;&gt; 16 Then Continue For&#xA;            Dim c0 As String = cellTexts(0).ToLower()&#xA;            If c0 = &quot;lygis&quot; OrElse c0.StartsWith(&quot;nustatytas&quot;) Then Continue For&#xA;            Dim anyVal As Boolean = False&#xA;            For Each cv As String In cellTexts&#xA;                If cv &lt;&gt; &quot;&quot; Then anyVal = True&#xA;            Next&#xA;            If anyVal Then dataRows.Add(cellTexts.ToArray())&#xA;        Next&#xA;    Next&#xA;End Using&#xA;out_RowCount = dataRows.Count&#xA;Dim dtNdnt As New System.Data.DataTable(&quot;NDNT&quot;)&#xA;For colN As Integer = 0 To 15&#xA;    dtNdnt.Columns.Add(&quot;Column-&quot; &amp; colN.ToString(), GetType(String))&#xA;Next&#xA;For Each dr As String() In dataRows&#xA;    dtNdnt.Rows.Add(CType(dr, Object()))&#xA;Next&#xA;out_ExtractDataTable = dtNdnt&#xA;dataRows.Reverse()&#xA;&#xA;' ---------- 4. Sekcijos ----------&#xA;Dim nowDate As DateTime = DateTime.Now&#xA;out_Dalyvumas = &quot;&quot;&#xA;out_Neigalumas = &quot;&quot;&#xA;out_Poreikiai = &quot;&quot;&#xA;Dim levelWords As String() = {&quot;pirmojo lygio&quot;, &quot;antrojo lygio&quot;, &quot;special&quot;, &quot;vidutin&quot;, &quot;didel&quot;, &quot;sunk&quot;}&#xA;For Each rw As String() In dataRows&#xA;    ' kiekvienai sekcijai: laikotarpis aktyvus, jei &quot;nuo&quot; be &quot;iki&quot; arba antroji data &gt;= šiandien&#xA;    For sec As Integer = 0 To 2&#xA;        Dim periodText As String = &quot;&quot;&#xA;        Dim candidate As String = &quot;&quot;&#xA;        If sec = 0 Then&#xA;            Dim lvl As Integer&#xA;            If Integer.TryParse(rw(4).Trim(), lvl) AndAlso lvl &lt;= 40 Then&#xA;                periodText = rw(6)&#xA;                candidate = &quot;DARB&quot; &amp; rw(4).Trim()&#xA;            End If&#xA;        ElseIf sec = 1 Then&#xA;            Dim lw As String = rw(0).ToLower()&#xA;            If lw &lt;&gt; &quot;&quot; AndAlso (lw.Contains(&quot;sunk&quot;) OrElse lw.Contains(&quot;vidut&quot;)) Then&#xA;                periodText = rw(1)&#xA;                candidate = rw(0).Trim().Split(&quot; &quot;c)(0)&#xA;            End If&#xA;        Else&#xA;            Dim pw As String = rw(10).ToLower()&#xA;            Dim levelHit As Boolean = False&#xA;            For Each wd As String In levelWords&#xA;                If pw.Contains(wd) Then levelHit = True&#xA;            Next&#xA;            If levelHit AndAlso rw(14).Trim() = &quot;&quot; Then&#xA;                periodText = rw(11)&#xA;                candidate = rw(10).Trim()&#xA;            End If&#xA;        End If&#xA;        If candidate = &quot;&quot; Then Continue For&#xA;        Dim secondDate As DateTime = DateTime.MinValue&#xA;        Dim pLow As String = periodText.ToLower()&#xA;        If periodText.Contains(&quot; - &quot;) AndAlso periodText.Split(&quot;-&quot;c).Length - 1 = 5 Then&#xA;            Dim secondPart As String = periodText.Split(New String() {&quot; - &quot;}, StringSplitOptions.None)(1).Trim()&#xA;            Dim parsed As DateTime&#xA;            If DateTime.TryParseExact(secondPart, &quot;yyyy-MM-dd&quot;, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, parsed) Then&#xA;                secondDate = parsed&#xA;            End If&#xA;        End If&#xA;        Dim isActive As Boolean = (pLow.Contains(&quot;nuo&quot;) AndAlso Not pLow.Contains(&quot;iki&quot;)) OrElse secondDate &gt;= nowDate.Date&#xA;        If isActive Then&#xA;            If sec = 0 Then out_Dalyvumas = candidate&#xA;            If sec = 1 Then out_Neigalumas = candidate&#xA;            If sec = 2 Then out_Poreikiai = candidate&#xA;        End If&#xA;    Next&#xA;Next&#xA;out_ResultValue = If(out_Poreikiai &lt;&gt; &quot;&quot;, out_Poreikiai, If(out_Neigalumas &lt;&gt; &quot;&quot;, out_Neigalumas, out_Dalyvumas))&#xA;" ContinueOnError="{x:Null}" DisplayName="Tabula_NDNT: ANTA PDF -> rezultatas (tabula-java)" Language="VBNet">
        <ui:InvokeCode.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_Path">[in_Path]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_JavaPath">[in_JavaPath]</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_ResultValue">[out_ResultValue]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_Dalyvumas">[dal]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_Neigalumas">[neig]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_Poreikiai">[por]</OutArgument>
          <OutArgument x:TypeArguments="x:Int32" x:Key="out_RowCount">[rowCount]</OutArgument>
          <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_ExtractDataTable">[out_ExtractDataTable]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_JavaUsed">[javaUsed]</OutArgument>
        </ui:InvokeCode.Arguments>
      </ui:InvokeCode>
    <ui:LogMessage DisplayName="Log NDNT" Level="Info" Message="[&quot;ANTA: eilučių &quot; &amp; rowCount.ToString &amp; &quot; | dalyvumas=&quot; &amp; dal &amp; &quot; | neįgalumas=&quot; &amp; neig &amp; &quot; | poreikiai=&quot; &amp; por &amp; &quot; =&gt; &quot; &amp; out_ResultValue]" />
    <Assign DisplayName="Žodynas (Lyg2toSPIS): reikšmė -> SPIS">
        <Assign.To>
          <OutArgument x:TypeArguments="x:String">[mapped]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:String">[If(String.IsNullOrEmpty(out_ResultValue) OrElse in_dt_Zodynas Is Nothing, Nothing, in_dt_Zodynas.AsEnumerable().Where(Function(r) r(1).ToString.ToLower.Contains(out_ResultValue.ToLower)).Select(Function(r) r(0).ToString.Trim).FirstOrDefault())]</InArgument>
        </Assign.Value>
      </Assign>
    <If Condition="[TargetRow IsNot Nothing]" DisplayName="Jei rasta eilutė pagal AK">
        <If.Then>
    <Assign DisplayName="Įrašyti į 40 stulpelį">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Object">[TargetRow(40)]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Object">[If(String.IsNullOrEmpty(mapped), out_ResultValue, mapped)]</InArgument>
        </Assign.Value>
      </Assign>
        </If.Then>
      </If>
  </Sequence>
</Activity>
